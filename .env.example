# ── Database ──────────────────────────────────────────────────────────────────
# Path to the SQLite file. Relative to project root (or absolute for Docker).
DATABASE_URL="./data/finops.db"

# ── Auth (better-auth) ────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-in-production"
BETTER_AUTH_URL="http://localhost:3000"

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_CURRENCY="NZD"
NEXT_PUBLIC_DEFAULT_LOCALE="en-NZ"

# ── Cron ──────────────────────────────────────────────────────────────────────
# Secret used by the internal cron job to call /api/internal/* endpoints
CRON_SECRET="change-me-in-production"

# ── AI (optional — receipt scanning) ─────────────────────────────────────────
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-4-5-20251001"

# ── Uploads ───────────────────────────────────────────────────────────────────
# Absolute path for receipt file storage. Defaults to <cwd>/uploads.
UPLOADS_DIR=""
