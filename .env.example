# ── Database ──────────────────────────────────────────────────────────────────
# Path to the SQLite file. Relative to project root (or absolute for Docker).
DATABASE_URL="./data/finops.db"

# ── Auth (better-auth) ────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-in-production"
BETTER_AUTH_URL="http://localhost:3000"

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_CURRENCY="NZD"
NEXT_PUBLIC_DEFAULT_LOCALE="en-NZ"

# ── Cron ──────────────────────────────────────────────────────────────────────
# Secret used by the internal cron job to call /api/internal/* endpoints
CRON_SECRET="change-me-in-production"

# ── Receipt scanning (OCR) ────────────────────────────────────────────────────
# Receipt scanning runs fully on-server via the system `tesseract` binary —
# no API key, no third party. The Docker image installs it automatically.
# Nothing to configure here. (On a dev machine without tesseract installed,
# uploads still work; they just won't auto-fill amount/date.)

# ── Uploads ───────────────────────────────────────────────────────────────────
# Absolute path for receipt file storage. Defaults to <cwd>/uploads.
UPLOADS_DIR=""
