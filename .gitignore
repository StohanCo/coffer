# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# next.js
/.next/
/out/

# production
/build

# env files (secrets — never commit)
.env*.local
.env
.env.production

# data & uploads (runtime state — never commit user data)
/data/
/uploads/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# NOTE: drizzle/ migrations ARE committed — the Docker image applies them on boot
# to create the schema on a fresh volume. Do not ignore them.

# ruflo / claude-flow local state (machine-specific, keep out of the repo)
/.claude-flow/
/.mcp.json
/CLAUDE.md
# Keep only the two project skills under .claude/, drop all ruflo scaffolding
/.claude/*
!/.claude/skills/
/.claude/skills/*
!/.claude/skills/homelab-finance/
!/.claude/skills/ui-ux-pro-max/

# typescript
*.tsbuildinfo
next-env.d.ts

# os
.DS_Store
Thumbs.db

# ide
.vscode/
.idea/
*.swp
